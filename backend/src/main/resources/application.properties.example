spring.application.name=backend

server.port=8079

# post
spring.servlet.encoding.charset=UTF-8
spring.servlet.encoding.enabled=true
spring.servlet.encoding.force=true

# DB설정 (본인 계정 정보로 채워서 application.properties로 복사해서 쓰세요)
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://호스트:포트/DB이름
spring.datasource.username=아이디
spring.datasource.password=비밀번호

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# 카카오 로그인 (로컬 개발용 예시 - 본인 로컬 주소로 바꿔서 사용)
kakao.rest-api-key=카카오_REST_API_키
kakao.redirect-uri=http://localhost:4000/Feely/Login/kakao/callback

# 배포(github.io <-> cloudflared) 시에는 아래처럼 실제 배포 주소로 바꾸고,
# 크로스도메인 세션 쿠키 허용 설정도 함께 켜야 함 (로컬 개발 중엔 불필요)
